# Local migration config
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
VITE_ENABLE_AUTH=false

# Public browser config. These values are safe to expose to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase config.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback if you do not have an sb_secret_ key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side AI calls and OpenAI Realtime token minting.
OPENAI_API_KEY=
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_DEEP=gpt-4o

# Azure Speech-to-text.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
